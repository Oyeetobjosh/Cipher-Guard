# Public URL of the deployed CipherGuard API. Use / when Vite proxies relative /api calls.
VITE_API_BASE_URL=https://api.your-cipherguard-domain.com

# Optional. Vite dev-server only proxy for a backend that does not allow CORS.
# VITE_API_PROXY_TARGET=https://api.your-cipherguard-domain.com

# Authentication is never hard-coded. Leave VITE_API_TOKEN blank if the backend
# authenticates with an HttpOnly session cookie.
VITE_API_TOKEN=
VITE_API_AUTH_HEADER=Authorization
VITE_API_AUTH_SCHEME=Bearer

# Override only when the deployed service uses different paths.
VITE_API_DASHBOARD_PATH=/api/dashboard
VITE_API_INTEGRATIONS_PATH=/api/integrations
VITE_API_TRAFFIC_PATH=/api/traffic
VITE_API_ALERTS_PATH=/api/alerts
VITE_API_POLICIES_PATH=/api/policies
VITE_API_ANALYTICS_PATH=/api/analytics
