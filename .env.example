# ==============================================================================
# CipherGuard backend environment (from the uploaded CipherGuard project)
# ==============================================================================
ENVIRONMENT=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:5173
DEFAULT_ORG_ID=a0000000-0000-0000-0000-000000000001
CIPHERGUARD_GATEWAY_URL=http://localhost:8000
SHIPFAST_UPSTREAM_URL=http://shipfast-api:8000
PAYFLEX_UPSTREAM_URL=http://payflex-api:8000
ALLOW_INTERNAL_NETWORKS=true

# ==============================================================================
# CipherGuard Security Dashboard (Vite)
# ==============================================================================
# The zip's public API gateway is normally http://localhost:8000 in development.
# Use your deployed API origin in production, for example https://api.cipherguard.com.
VITE_API_BASE_URL=http://localhost:8000

# Send a Supabase JWT when the deployed management API requires authentication.
# Never put a Supabase service-role key here: it belongs only on the backend.
VITE_API_TOKEN=
VITE_API_AUTH_HEADER=Authorization
VITE_API_AUTH_SCHEME=Bearer

# Optional local-development proxy. With this set, use VITE_API_BASE_URL=/.
# VITE_API_PROXY_TARGET=http://localhost:8000

# Exact management routes supplied by docs/API.md. Override only for a custom deployment.
VITE_API_INTEGRATIONS_PATH=/api/v1/integrations
VITE_API_TRAFFIC_PATH=/api/v1/traffic
VITE_API_TRAFFIC_STATS_PATH=/api/v1/traffic/stats
VITE_API_ALERTS_PATH=/api/v1/alerts
VITE_API_POLICIES_PATH=/api/v1/policies
VITE_API_ANALYTICS_PATH=/api/v1/analytics/overview
